# ================================================
# 绿链锂电采购平台 - Git 忽略规则
# ================================================

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.iml
*.iws
*.ipr
.settings/
.project
.classpath
.factorypath

# ---------- Java / Maven ----------
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar

# ---------- 前端 Node / Vite ----------
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.DS_Store
frontend/*.local

# ---------- 日志 & 运行时临时文件 ----------
*.log
*.log.*
backend.log
backend-start.log
frontend-start.log
build-process-*.log
compile-process-*.log
*.trace
*.dump
*.tmp
*.swp
*.swo
*~

# ---------- Redis 持久化 ----------
dump.rdb
appendonly.aof

# ---------- 用户上传文件（本地磁盘存储） ----------
uploads/

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------- 环境变量 & 敏感配置 ----------
.env
.env.local
.env.*.local

# ---------- 其他临时/个人文件 ----------
.trae/documents/

# ---------- 本地私有配置（密钥 / 密码 / 真实地址）----------
application-local.yml

# ---------- 个人隐私（面试资料 / AI 工作目录，严禁上传）----------
interview-prep/
.workbuddy/
~$*.docx
~$*.doc
~$*.xlsx
