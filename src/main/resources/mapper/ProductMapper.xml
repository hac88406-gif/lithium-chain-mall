<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.greenchain.mapper.ProductMapper">
    <select id="findByCategoryId" resultType="com.greenchain.entity.Product">
        SELECT * FROM product WHERE category_id = #{categoryId} AND status = 1
    </select>
</mapper>